# --- LLM (any OpenAI-compatible /chat/completions endpoint with tool calling) ---
# On a Sprite, use the connector gateway URL from the connector's detail page (no key needed), e.g.
#   OpenRouter: https://api.sprites.dev/v1/gateway/openrouter/<connection_id>/api/v1
#   Anthropic:  https://api.sprites.dev/v1/gateway/anthropic/<connection_id>/v1
#   Ollama:     https://api.sprites.dev/v1/gateway/ollama/<connection_id>/v1
LLM_BASE_URL=https://api.sprites.dev/v1/gateway/openrouter/CONNECTION_ID/api/v1
LLM_MODEL=anthropic/claude-sonnet-5.5
# LLM_API_KEY=   # local dev only (outside a Sprite)

# --- AgentMail (Sprites connector): the agent's inbox for forwarded receipts and card alerts ---
AGENTMAIL_BASE_URL=https://api.sprites.dev/v1/gateway/agentmail/CONNECTION_ID
AGENTMAIL_INBOX=your-upscore@agentmail.to
OWNER_EMAILS=you@example.com            # the agent only replies to and reminds these addresses
# AGENTMAIL_API_KEY=   # local dev only
EMAIL_POLL_SECS=60

# --- Telegram (talk to the agent in natural language) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=     # optional; otherwise the first chat to /start the bot becomes the owner

# --- Web dashboard ---
PORT=8080
WEB_TOKEN=change-me                     # open https://<sprite-url>/?token=change-me
# UPSCORE_DB=~/.upscore/upscore.db
