# --- LLM: pick a provider with one flag ---
# ollama = FREE: Ollama running on the Sprite (default model qwen3.5:4b, CPU, tools + vision)
# meta   = PAID: Meta Model API via the Sprites "Meta" connector (Muse Spark chats, Muse Ember reads email)
LLM_PROVIDER=ollama
META_BASE_URL=https://api.sprites.dev/v1/gateway/meta/CONNECTION_ID/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional overrides for any provider:
# LLM_MODEL=  LLM_FAST_MODEL=  LLM_REASONING_EFFORT=  LLM_TIMEOUT=240  LLM_API_KEY= (local dev, paid providers)

# --- Voice: speech-to-text for the dashboard mic and Telegram voice notes (Sprites Deepgram connector) ---
DEEPGRAM_BASE_URL=https://api.sprites.dev/v1/gateway/deepgram/CONNECTION_ID
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_API_KEY=   # local dev only

# --- AgentMail (Sprites connector): the agent's inbox for forwarded receipts and card alerts ---
AGENTMAIL_BASE_URL=https://api.sprites.dev/v1/gateway/agentmail/CONNECTION_ID
AGENTMAIL_INBOX=your-upscore@agentmail.to
OWNER_EMAILS=you@example.com            # the agent only replies to and reminds these addresses
# AGENTMAIL_API_KEY=   # local dev only
EMAIL_POLL_SECS=60

# --- Telegram (talk to the agent in natural language) ---
TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=     # optional; otherwise the first chat to /start the bot becomes the owner

# --- Slack (Bot) connector: chat with the agent in a channel or DM ---
# Invite the bot to the channel. It needs chat:write plus channels:history (or im:history for a DM).
SLACK_BASE_URL=https://api.sprites.dev/v1/gateway/slack/CONNECTION_ID
SLACK_CHANNEL=                    # channel id (C...) or DM id (D...)
# SLACK_BOT_TOKEN=                # local dev only (then SLACK_BASE_URL=https://slack.com/api)
SLACK_POLL_SECS=5

# --- Connectors are found automatically on a Sprite (GET https://api.sprites.dev/v1/gateway/list) ---
# Add one in Fly → Sprites → Connectors, grant it to this Sprite, restart the service. <PROVIDER>_BASE_URL overrides.
#   era        bank accounts + transactions (fmk_ key with banking:read)       -> synced every 30 min
#   pushover   phone push for reminders/unlocks; also set PUSHOVER_USER=<your user key>
#   tavily/exa web search: rotating card categories, cancellation info
#   pinecone   semantic search over transactions (index PINECONE_INDEX, created automatically)
#   typesafe   Jev categorizes purchases
#   box        statement uploads archived to BOX_FOLDER
#   deepgram   voice in (mic, Telegram voice notes) and Pip's spoken voice
PUSHOVER_USER=
# PINECONE_INDEX=upscore
# BOX_FOLDER=Upscore statements

# --- Weekly check-in (sent to Telegram/Slack/email) ---
CHECKIN_WEEKDAY=6                 # 0=Mon .. 6=Sun
CHECKIN_HOUR=10

# --- Web dashboard ---
PORT=8080
WEB_TOKEN=change-me                     # open https://<sprite-url>/?token=change-me
# UPSCORE_DB=~/.upscore/upscore.db
